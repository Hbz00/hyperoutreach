# Application
NODE_ENV=development
APP_URL=http://localhost:3000
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=replace-with-a-long-unique-password
OPERATOR_API_TOKEN=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Keep Secure cookies on outside local HTTP tests. Do not set false in production.
# OPERATOR_COOKIE_SECURE=false
# AES-GCM secret keyring: comma-separated key-id:base64(32 bytes).
# Required for Microsoft tokens and SMTP/IMAP passwords. Keep retired keys
# during rotation until every stored secret has been re-encrypted.
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=local-v1
TOKEN_ENCRYPTION_KEYS=local-v1:replace-with-a-32-byte-base64-key

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://hyperoutreach:hyperoutreach@localhost:55432/hyperoutreach
# Integration tests use this disposable URL and compare it with DATABASE_URL.
TEST_DATABASE_URL=postgresql://hyperoutreach:hyperoutreach@localhost:55432/hyperoutreach_test

# Safe local defaults. MAIL_PROVIDER only selects the credential-free fallback;
# real Microsoft and SMTP/IMAP providers are resolved per connected mailbox.
# OPENAI_PROVIDER accepts exactly mock, openai, or codex.
OPENAI_PROVIDER=mock
MAIL_PROVIDER=mock
# local is the PostgreSQL-backed in-process executor. Legacy mock is an alias.
WORKFLOW_PROVIDER=local

# OpenAI Responses API (used only when OPENAI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna

# Local Codex CLI (used only when OPENAI_PROVIDER=codex). Both web research and
# non-web AI use the authenticated local CLI; no OpenAI API key is required.
# Codex requires local workflows and cannot use WORKFLOW_PROVIDER=trigger.
CODEX_EXECUTABLE=codex
CODEX_RESEARCH_MODEL=gpt-5.6-terra
CODEX_FAST_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_MS=240000
CODEX_MAX_CONCURRENCY=1

# Microsoft Graph OAuth (required when connecting a Microsoft mailbox)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback
MICROSOFT_GRAPH_WEBHOOK_CLIENT_STATE=
MICROSOFT_GRAPH_NOTIFICATION_URL=https://your-public-host.example/api/webhooks/microsoft

# SMTP/IMAP has no global host variables. Add each mailbox in /settings with
# its own hosts, ports, TLS mode, username, and app-specific password. Plain
# IMAP/SMTP is rejected: use implicit TLS or mandatory STARTTLS.

# Trigger.dev (required only when WORKFLOW_PROVIDER=trigger)
# The checked-in configuration targets the Node 22 runtime.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
